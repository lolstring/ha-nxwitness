{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Develop: Home Assistant (source)",
      "detail": "Run hass from source with debug + debugpy:5678",
      "type": "shell",
      "command": "scripts/develop",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^this line shall never match$",
          "endsPattern": "(Debugpy|Waiting for|Home Assistant initialized)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Test: run all",
      "type": "shell",
      "command": "python -m pytest tests/ -q",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Test: config flow only",
      "type": "shell",
      "command": "python -m pytest tests/test_config_flow.py -q",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Lint: ruff check",
      "type": "shell",
      "command": "python -m ruff check custom_components/nxwitness tests",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Lint: ruff format check",
      "type": "shell",
      "command": "python -m ruff format --check custom_components/nxwitness tests",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Type check: mypy",
      "type": "shell",
      "command": "python -m mypy custom_components/nxwitness",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        {
          "owner": "mypy",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "pattern": {
            "regexp": "^(.+):(\\d+):(\\d+): (error|warning|note): (.+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ]
    },
    {
      "label": "Restart Home Assistant",
      "type": "shell",
      "command": "docker compose restart homeassistant",
      "problemMatcher": [],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "close": true
      }
    },
    {
      "label": "Reconfigure Home Assistant",
      "type": "shell",
      "command": "docker compose up --detach --force-recreate homeassistant",
      "problemMatcher": [],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "close": true
      }
    },
    {
      "label": "Home Assistant",
      "type": "shell",
      "command": "docker compose up -d homeassistant && docker compose logs --follow homeassistant",
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^this line shall never match$",
          "endsPattern": "Listening for remote debug connection on"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}
