#!/usr/bin/env bash
# Run Home Assistant from source with this integration loaded, debug logging,
# and a debugpy listener on :5678 (integration_blueprint style).
#
# One-command dev loop:
#   scripts/develop
# then attach the "Home Assistant (develop)" debug config, or just edit and
# Ctrl-C / re-run. Generated config lives in ./config (git-ignored).
set -euo pipefail
cd "$(dirname "$0")/.."

mkdir -p config

# Deterministic, reproducible config. If the file is still script-generated,
# refresh it every run so debug settings stay correct.
if [ ! -f config/configuration.yaml ] || grep -q "^# Generated by scripts/develop" config/configuration.yaml; then
    cat > config/configuration.yaml <<'EOF'
# Generated by scripts/develop - safe to delete; it will be regenerated.

homeassistant:
  name: NX Witness Dev
  unit_system: metric
  time_zone: UTC

http:
api:
config:
frontend:

logger:
  default: info
  logs:
    custom_components.nxwitness: debug

# Remote debugging: VS Code "Home Assistant (develop)" attaches here.
debugpy:

lovelace:
  mode: storage
  resources:
    - url: /local/nxwitness-camera-card/nxwitness-camera-card.js
      type: module
EOF
fi

# HA discovers custom components under <config>/custom_components.
ln -sfn "$(pwd)/custom_components" config/custom_components
mkdir -p config/www
ln -sfn "$(pwd)/www/nxwitness-camera-card" config/www/nxwitness-camera-card

exec hass --config config --debug
