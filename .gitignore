# Project-local generated content (README screenshots are tracked)
docs/*
!docs/screenshots/
# Runtime Home Assistant state only; the e2e/dev compose, sample config and
# docs under local-testing/ are tracked.
local-testing/config/

# Agent-local working directory
.claude/

